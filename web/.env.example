# Copy to .env.local for local development. Never commit real values.

# Atlas connection string. The database name must end in _dev for seeding to run.
MONGODB_URI=

# demo uses Cloudinary's public demo images until the real account in Phase 4.
CLOUDINARY_CLOUD_NAME=demo

# Optional. The public address of the website.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
