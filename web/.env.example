# Copy to .env.local for local development. Never commit real values.

# Atlas connection string. The database name must end in _dev, or scripts that
# change data ask for --confirm=<database name>.
MONGODB_URI=

# From the Cloudinary console: cloudinary://<api key>:<api secret>@<cloud name>.
# Secret. Used by the seed script now, and to sign uploads from Phase 4.
CLOUDINARY_URL=

# The cloud name from CLOUDINARY_URL. Sent to the app, which builds image addresses from it.
CLOUDINARY_CLOUD_NAME=

# Optional. The public address of the website.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signs access tokens. At least 32 random characters, different in every
# environment: openssl rand -base64 48
JWT_SECRET=

# Expected audience of Google ID tokens: the web OAuth client ID.
GOOGLE_WEB_CLIENT_ID=

# Expected audience of Apple identity tokens.
APPLE_BUNDLE_ID=com.hautecorner.app

# Email through Amazon SES. log prints emails instead, for local testing.
EMAIL_TRANSPORT=ses
EMAIL_FROM="HauteCorner Lifestyle"
SES_REGION=eu-west-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=

# M-Pesa Express through Safaricom Daraja (Phase 5). Sandbox shortcode: 174379.
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
# Random text added to the callback address: openssl rand -hex 24
DARAJA_CALLBACK_TOKEN=

# Paystack cards (Phase 5). sk_test_ keys until launch.
PAYSTACK_SECRET_KEY=

# Protects /api/v1/cron/* routes.
CRON_SECRET=

# true lets checkout pay without provider keys. Only works on a _dev or _test database.
PAYMENTS_SIMULATED=
