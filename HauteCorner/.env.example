# Copy to .env.local. These values are compiled into the app, so never put secrets here.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Google Sign-In client IDs (Phase 3). Client IDs are not secret.
# The web client is the audience the API checks. The iOS client is needed on iOS.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
